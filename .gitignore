.venv/
__pycache__/
tools/vendor/
node_modules/
# Binaries for e-readers are shipped as GitHub Release assets, not committed.
packages/*/dist/eink/
packages/*/dist/release/
# Web fonts are rebuilt in CI and uploaded to cdn.sharosoo.com, not committed.
packages/*/dist/web/
packages/*/upstream/cache/
packages/*/upstream/maruburi/
